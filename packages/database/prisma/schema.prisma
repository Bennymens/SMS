// ─────────────────────────────────────────────────────────────────────────────
// School Management System — Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED
  SUSPENDED
  EXPELLED
  INACTIVE
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HOLIDAY
}

enum ExamType {
  MID_TERM
  FINAL
  QUIZ
  TEST
  CA
  ASSIGNMENT
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum FeeFrequency {
  ONCE
  MONTHLY
  TERMLY
  ANNUALLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  CHEQUE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum AnnouncementType {
  GENERAL
  ACADEMIC
  FEE
  EVENT
  HOLIDAY
  EMERGENCY
}

enum DocumentType {
  BIRTH_CERTIFICATE
  ADMISSION_FORM
  TRANSCRIPT
  REPORT_CARD
  ID_CARD
  MEDICAL_RECORD
  CONTRACT
  RECEIPT
  PASSPORT_PHOTO
  OTHER
}

// ─────────────────────────────────────────────────────────────────────────────
// FOUNDATION
// ─────────────────────────────────────────────────────────────────────────────

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  address   Json
  phone     String
  email     String
  website   String?
  timezone  String   @default("UTC")
  currency  String   @default("USD")
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  classes       Class[]
  subjects      Subject[]
  students      Student[]
  teachers      Teacher[]
  parents       Parent[]
  announcements Announcement[]
  auditLogs     AuditLog[]
  documents     Document[]
  feeStructures FeeStructure[]

  @@map("schools")
}

model User {
  id            String    @id @default(cuid())
  schoolId      String?
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          Role
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  school        School?        @relation(fields: [schoolId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  notifications Notification[]
  permissions   Permission[]

  @@index([schoolId, role])
  @@map("users")
}

model Permission {
  id       String  @id @default(cuid())
  userId   String
  resource String
  action   String
  granted  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action])
  @@map("permissions")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School               @relation(fields: [schoolId], references: [id])
  terms       Term[]
  classes     Class[]
  enrollments StudentEnrollment[]
  feeRecords  FeeRecord[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@map("academic_years")
}

model Term {
  id             String   @id @default(cuid())
  academicYearId String
  schoolId       String
  name           String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id])
  examinations      Examination[]
  attendanceRecords AttendanceRecord[]
  feeRecords        FeeRecord[]
  reportCards       ReportCard[]

  @@unique([academicYearId, name])
  @@map("terms")
}

model Class {
  id             String   @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  level          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  sections     Section[]
  feeStructures FeeStructure[]

  @@unique([schoolId, academicYearId, name])
  @@map("classes")
}

model Section {
  id        String   @id @default(cuid())
  classId   String
  schoolId  String
  name      String
  capacity  Int      @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class         Class               @relation(fields: [classId], references: [id])
  classTeacherId String?            @unique
  classTeacher  Teacher?            @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  enrollments   StudentEnrollment[]
  timetableSlots TimetableSlot[]
  attendanceRecords AttendanceRecord[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  code        String
  description String?
  isElective  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id])
  classSubjects ClassSubject[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  sectionId String?
  subjectId String
  teacherId String
  schoolId  String
  createdAt DateTime @default(now())

  subject         Subject          @relation(fields: [subjectId], references: [id])
  teacher         Teacher          @relation(fields: [teacherId], references: [id])
  timetableSlots  TimetableSlot[]
  assignments     Assignment[]
  grades          Grade[]
  examSchedules   ExamSchedule[]

  @@unique([sectionId, subjectId])
  @@map("class_subjects")
}

// ─────────────────────────────────────────────────────────────────────────────
// PEOPLE
// ─────────────────────────────────────────────────────────────────────────────

model Student {
  id            String        @id @default(cuid())
  userId        String        @unique
  schoolId      String
  admissionNo   String        @unique
  admissionDate DateTime      @db.Date
  dateOfBirth   DateTime      @db.Date
  gender        Gender
  bloodGroup    String?
  religion      String?
  nationality   String?
  address       Json
  medicalInfo   Json?         @default("{}")
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user            User                   @relation(fields: [userId], references: [id])
  school          School                 @relation(fields: [schoolId], references: [id])
  enrollments     StudentEnrollment[]
  attendances     AttendanceRecord[]
  grades          Grade[]
  feeRecords      FeeRecord[]
  documents       Document[]
  submissions     AssignmentSubmission[]
  parentLinks     ParentStudent[]
  reportCards     ReportCard[]

  @@index([schoolId, status])
  @@index([admissionNo])
  @@map("students")
}

// Add the reverse relation to User model via raw SQL extension
// (handled in application layer)

model StudentEnrollment {
  id             String   @id @default(cuid())
  studentId      String
  sectionId      String
  academicYearId String
  rollNumber     String?
  promotedFrom   String?
  enrolledAt     DateTime @default(now())

  student      Student      @relation(fields: [studentId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, academicYearId])
  @@map("student_enrollments")
}

model Parent {
  id         String   @id @default(cuid())
  userId     String   @unique
  schoolId   String
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  school   School          @relation(fields: [schoolId], references: [id])
  children ParentStudent[]

  @@map("parents")
}

model ParentStudent {
  id           String  @id @default(cuid())
  parentId     String
  studentId    String
  relationship String
  isPrimary    Boolean @default(false)
  canPickup    Boolean @default(true)

  parent  Parent  @relation(fields: [parentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model Teacher {
  id           String       @id @default(cuid())
  userId       String       @unique
  schoolId     String
  employeeId   String       @unique
  qualification String?
  specialization String[]
  joiningDate  DateTime     @db.Date
  salary       Decimal?     @db.Decimal(10, 2)
  contractType ContractType @default(FULL_TIME)
  status       StaffStatus  @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  classSubjects  ClassSubject[]
  homeSection    Section?         @relation("SectionClassTeacher")
  attendances    StaffAttendance[]

  @@index([schoolId, status])
  @@map("teachers")
}

// ─────────────────────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────────────────────

model TimetableSlot {
  id             String  @id @default(cuid())
  sectionId      String
  classSubjectId String
  dayOfWeek      Int
  periodNumber   Int
  startTime      String
  endTime        String
  room           String?
  academicYearId String

  section      Section      @relation(fields: [sectionId], references: [id])
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])

  periodAttendances PeriodAttendance[]

  @@map("timetable_slots")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceRecord {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  sectionId  String
  termId     String
  date       DateTime         @db.Date
  status     AttendanceStatus
  remark     String?
  markedById String
  markedAt   DateTime         @default(now())

  student           Student            @relation(fields: [studentId], references: [id])
  section           Section            @relation(fields: [sectionId], references: [id])
  term              Term               @relation(fields: [termId], references: [id])
  periodAttendances PeriodAttendance[]

  @@unique([studentId, date, sectionId])
  @@index([schoolId, date])
  @@map("attendance_records")
}

model PeriodAttendance {
  id                 String           @id @default(cuid())
  attendanceRecordId String
  timetableSlotId    String
  status             AttendanceStatus

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id])
  timetableSlot    TimetableSlot    @relation(fields: [timetableSlotId], references: [id])

  @@map("period_attendances")
}

model StaffAttendance {
  id        String           @id @default(cuid())
  teacherId String
  schoolId  String
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("staff_attendances")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAMINATIONS & GRADES
// ─────────────────────────────────────────────────────────────────────────────

model Examination {
  id          String   @id @default(cuid())
  schoolId    String
  termId      String
  name        String
  type        ExamType
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  term      Term           @relation(fields: [termId], references: [id])
  schedules ExamSchedule[]
  grades    Grade[]

  @@map("examinations")
}

model ExamSchedule {
  id             String   @id @default(cuid())
  examinationId  String
  classSubjectId String
  date           DateTime @db.Date
  startTime      String
  endTime        String
  room           String?
  maxMarks       Decimal  @db.Decimal(6, 2)
  passingMarks   Decimal  @db.Decimal(6, 2)

  examination  Examination  @relation(fields: [examinationId], references: [id])
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])

  @@map("exam_schedules")
}

model Grade {
  id             String   @id @default(cuid())
  schoolId       String
  studentId      String
  examinationId  String
  classSubjectId String
  marksObtained  Decimal  @db.Decimal(6, 2)
  maxMarks       Decimal  @db.Decimal(6, 2)
  grade          String?
  gradePoint     Decimal? @db.Decimal(4, 2)
  remarks        String?
  isAbsent       Boolean  @default(false)
  enteredById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  examination  Examination  @relation(fields: [examinationId], references: [id])
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id])

  @@unique([studentId, examinationId, classSubjectId])
  @@index([schoolId, examinationId])
  @@map("grades")
}

model GradingScale {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  ranges GradeRange[]

  @@map("grading_scales")
}

model GradeRange {
  id             String  @id @default(cuid())
  gradingScaleId String
  minPercent     Decimal @db.Decimal(5, 2)
  maxPercent     Decimal @db.Decimal(5, 2)
  grade          String
  gradePoint     Decimal @db.Decimal(4, 2)
  description    String?

  gradingScale GradingScale @relation(fields: [gradingScaleId], references: [id])

  @@map("grade_ranges")
}

model ReportCard {
  id              String    @id @default(cuid())
  studentId       String
  termId          String
  schoolId        String
  totalMarks      Decimal   @db.Decimal(8, 2)
  obtainedMarks   Decimal   @db.Decimal(8, 2)
  percentage      Decimal   @db.Decimal(5, 2)
  overallGrade    String
  classRank       Int?
  attendance      Json
  teacherRemark   String?
  principalRemark String?
  pdfUrl          String?
  generatedAt     DateTime  @default(now())
  publishedAt     DateTime?

  student Student @relation(fields: [studentId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@map("report_cards")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEE MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model FeeStructure {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  classId        String?
  name           String
  amount         Decimal      @db.Decimal(10, 2)
  frequency      FeeFrequency
  dueDay         Int?
  lateFee        Decimal      @default(0) @db.Decimal(10, 2)
  isOptional     Boolean      @default(false)
  createdAt      DateTime     @default(now())

  school       School       @relation(fields: [schoolId], references: [id])
  class        Class?       @relation(fields: [classId], references: [id])
  feeRecords   FeeRecord[]

  @@map("fee_structures")
}

model FeeRecord {
  id             String    @id @default(cuid())
  schoolId       String
  studentId      String
  feeStructureId String
  academicYearId String
  termId         String?
  amountDue      Decimal   @db.Decimal(10, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(10, 2)
  discount       Decimal   @default(0) @db.Decimal(10, 2)
  discountReason String?
  dueDate        DateTime  @db.Date
  status         FeeStatus @default(UNPAID)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  payments     Payment[]

  @@index([schoolId, status])
  @@index([studentId])
  @@map("fee_records")
}

model Payment {
  id             String        @id @default(cuid())
  schoolId       String
  feeRecordId    String
  studentId      String
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  transactionRef String?       @unique
  gateway        String?
  gatewayRef     String?
  paidAt         DateTime      @default(now())
  receivedById   String
  receiptNo      String        @unique
  receiptUrl     String?
  notes          String?
  status         PaymentStatus @default(SUCCESS)

  feeRecord FeeRecord @relation(fields: [feeRecordId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────────
// ASSIGNMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Assignment {
  id             String   @id @default(cuid())
  schoolId       String
  classSubjectId String
  title          String
  description    String
  attachments    String[]
  dueDate        DateTime
  maxMarks       Decimal? @db.Decimal(6, 2)
  isPublished    Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classSubject ClassSubject           @relation(fields: [classSubjectId], references: [id])
  submissions  AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  content      String?
  attachments  String[]
  submittedAt  DateTime         @default(now())
  marksAwarded Decimal?         @db.Decimal(6, 2)
  feedback     String?
  status       SubmissionStatus @default(SUBMITTED)

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id             String           @id @default(cuid())
  schoolId       String
  title          String
  content        String
  type           AnnouncementType
  targetRoles    Role[]
  targetClassIds String[]
  attachments    String[]
  isPinned       Boolean          @default(false)
  publishAt      DateTime         @default(now())
  expiresAt      DateTime?
  createdById    String
  createdAt      DateTime         @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@map("announcements")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  schoolId  String
  title     String
  message   String
  type      String
  link      String?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENTS & AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model Document {
  id           String       @id @default(cuid())
  schoolId     String
  ownerId      String
  ownerType    String
  name         String
  type         DocumentType
  fileUrl      String
  fileSize     Int
  mimeType     String
  isVerified   Boolean      @default(false)
  verifiedById String?
  uploadedAt   DateTime     @default(now())
  expiresAt    DateTime?

  school   School   @relation(fields: [schoolId], references: [id])
  student  Student? @relation(fields: [ownerId], references: [id])

  @@index([schoolId, ownerId])
  @@map("documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String
  userId     String
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([schoolId, resource, createdAt])
  @@map("audit_logs")
}
